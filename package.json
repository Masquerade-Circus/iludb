{
  "name": "iludb",
  "version": "1.0.0",
  "description": "IluDb is a minimal in-memory database for Node.js and the web.",
  "repository": "git@github.com:Masquerade-Circus/iludb.git",
  "author": "Masquerade <christian@masquerade-circus.net>",
  "license": "Apache-2.0",
  "private": false,
  "packageManager": "bun@1.4.0-canary.1",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/iludb.js",
  "types": "./dist/iludb.d.ts",
  "browser": "./dist/iludb.min.js",
  "unpkg": "./dist/iludb.min.js",
  "jsdelivr": "./dist/iludb.min.js",
  "minified:main": "dist/iludb.min.js",
  "exports": {
    ".": {
      "types": "./dist/iludb.d.ts",
      "default": "./dist/iludb.js"
    },
    "./plugins/node-json": {
      "types": "./dist/plugins/node-json.d.ts",
      "default": "./dist/plugins/node-json.js"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run build && bun test ./test/index.ts ./test/entrypoints.test.ts",
    "bench": "bun run build && bun run bench/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.2.20",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0"
  }
}
